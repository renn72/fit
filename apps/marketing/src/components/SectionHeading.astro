---
interface Props {
	eyebrow?: string
	title: string
	description?: string
	align?: 'left' | 'center'
}

const { eyebrow, title, description, align = 'left' }: Props = Astro.props
const alignmentClass =
	align === 'center' ? 'section-heading center' : 'section-heading'
---

<div class={alignmentClass}>
  {eyebrow && <p class='eyebrow'>{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class='section-description'>{description}</p>}
</div>
