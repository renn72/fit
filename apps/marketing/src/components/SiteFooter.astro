---
import { navLinks, site } from '../data/site'

const year = new Date().getFullYear()
---

<footer class='site-footer'>
  <div class='container footer-grid'>
    <div class='footer-brand'>
      <p class='eyebrow'>{site.byline}</p>
      <h2>{site.name}</h2>
      <p>{site.tagline}</p>
    </div>

    <div>
      <h3>Explore</h3>
      <ul class='footer-links'>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Platform Focus</h3>
      <ul class='footer-links'>
        <li>Trainer-first operations</li>
        <li>AI-assisted workflows</li>
        <li>High-performance oversight</li>
      </ul>
    </div>
  </div>

	<div class='container footer-bottom'>
		<p>(c) {year} {site.name} by WSYS. All rights reserved.</p>
		<p>Serious coaching operating system for professionals.</p>
	</div>
</footer>
