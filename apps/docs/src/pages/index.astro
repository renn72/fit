---
const links = [
	{
		label: 'Workflow Overview',
		href: '/guides/user-menu-system/workflow-overview/',
		description: 'Full sequence from setup to user assignment.',
	},
	{
		label: 'Create Ingredients',
		href: '/guides/user-menu-system/create-ingredients/',
		description: 'Build your organization ingredient library first.',
	},
	{
		label: 'Create Recipes',
		href: '/guides/user-menu-system/create-recipes/',
		description: 'Create reusable recipes from your ingredients.',
	},
	{
		label: 'Create Menu Templates',
		href: '/guides/user-menu-system/create-menu-templates/',
		description: 'Build standardized templates for faster delivery.',
	},
	{
		label: 'Assign Menu Template to User',
		href: '/guides/user-menu-system/assign-menu-template-to-user/',
		description: 'Apply templates to users and personalize as needed.',
	},
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Forma Docs</title>
		<meta
			name="description"
			content="Trainer-first product documentation for coaching workflows in Forma."
		/>
		<style>
			:root {
				color-scheme: dark;
				font-family: "Plus Jakarta Sans", "Inter", "Segoe UI", sans-serif;
				background: #060a16;
				color: #e7ecff;
			}
			body {
				margin: 0;
				min-height: 100vh;
				background:
					radial-gradient(1200px 500px at 10% -20%, #1d2e66 0%, transparent 70%),
					radial-gradient(900px 600px at 90% -15%, #122a5c 0%, transparent 70%),
					linear-gradient(180deg, #060a16 0%, #090f1e 100%);
			}
			main {
				max-width: 980px;
				margin: 0 auto;
				padding: 4rem 1.25rem 3.5rem;
			}
			.kicker {
				display: inline-block;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				font-size: 0.78rem;
				color: #9eb6ff;
				margin-bottom: 1rem;
			}
			h1 {
				margin: 0;
				font-size: clamp(2rem, 5vw, 3.3rem);
				line-height: 1.05;
				letter-spacing: -0.02em;
			}
			.subtitle {
				margin-top: 1rem;
				max-width: 60ch;
				color: #b8c7f8;
				font-size: 1.02rem;
			}
			.cta-row {
				display: flex;
				gap: 0.8rem;
				flex-wrap: wrap;
				margin-top: 1.5rem;
				margin-bottom: 2.3rem;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.72rem 1.05rem;
				border-radius: 0.75rem;
				font-weight: 600;
				text-decoration: none;
				border: 1px solid transparent;
			}
			.btn-primary {
				background: linear-gradient(115deg, #5f8dff 0%, #58d0ff 100%);
				color: #05112b;
			}
			.btn-secondary {
				background: rgba(32, 44, 86, 0.45);
				border-color: rgba(153, 178, 255, 0.28);
				color: #d9e4ff;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 0.9rem;
			}
			.card {
				display: block;
				padding: 1rem;
				border-radius: 0.95rem;
				background: rgba(22, 30, 58, 0.7);
				border: 1px solid rgba(145, 170, 245, 0.2);
				text-decoration: none;
				color: inherit;
				transition: border-color 0.14s ease, transform 0.14s ease;
			}
			.card:hover {
				border-color: rgba(126, 167, 255, 0.52);
				transform: translateY(-1px);
			}
			.card h2 {
				font-size: 1rem;
				margin: 0 0 0.4rem;
			}
			.card p {
				margin: 0;
				color: #b9c9f7;
				font-size: 0.92rem;
				line-height: 1.42;
			}
		</style>
	</head>
	<body>
		<main>
			<span class="kicker">Forma Docs</span>
			<h1>Shape better programs. Deliver better outcomes.</h1>
			<p class="subtitle">
				Trainer-first documentation for the Forma coaching operating system. Start with the user menu
				workflow to set up ingredients, recipes, templates, and delivery.
			</p>

			<div class="cta-row">
				<a class="btn btn-primary" href="/guides/user-menu-system/workflow-overview/">Start Workflow</a>
				<a class="btn btn-secondary" href="https://forma.wsys.com/contact">Book a Demo</a>
			</div>

			<section class="grid" aria-label="Docs quick links">
				{
					links.map((link) => (
						<a class="card" href={link.href}>
							<h2>{link.label}</h2>
							<p>{link.description}</p>
						</a>
					))
				}
			</section>
		</main>
	</body>
</html>
