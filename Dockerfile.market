# syntax=docker/dockerfile:1

FROM node:22-alpine AS builder

WORKDIR /app

# Enable the workspace's pnpm version via Corepack
RUN corepack enable && corepack prepare pnpm@10.26.0 --activate

# Copy workspace metadata first for better layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./

# Copy only the marketing app source
COPY apps/marketing ./apps/marketing

# Install only marketing app deps (and any transitive workspace deps if added later)
RUN pnpm install --frozen-lockfile --filter marketing...

# Build Astro static output
RUN pnpm --filter marketing build

FROM nginx:1.27-alpine AS runner

# Copy built static site
COPY --from=builder /app/apps/marketing/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
